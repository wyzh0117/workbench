+    #[test]
+    fn native_asset_rename_ack_baseline_red() {
+        let directory = test_directory("rename-ack-baseline");
+        let project_dir = directory.to_string_lossy().into_owned();
+        project_create(
+            project_dir.clone(),
+            json!({
+                "project": { "id": "p-rename-baseline", "title": "before" },
+                "assets": [{
+                    "id": "asset-1", "filename": "cover.png",
+                    "storage_path": "assets/asset-1-cover.png", "mime_type": "image/png",
+                    "file_size": 3, "checksum": "hash-1", "archived": false
+                }],
+            }),
+        )
+        .expect("project");
+        fs::create_dir_all(directory.join("assets")).expect("assets dir");
+        fs::write(directory.join("assets/asset-1-cover.png"), [1_u8, 2, 3]).expect("asset");
+        let expected_fingerprint = project_fingerprint(&directory).expect("open fingerprint");
+        let lease_generation = active_lease_generation(&directory).expect("active lease");
+        let ack = asset_rename(json!({
+            "project_dir": project_dir,
+            "asset_id": "asset-1",
+            "new_name": "new-cover.png",
+            "expected_project_id": "p-rename-baseline",
+            "expected_fingerprint": expected_fingerprint,
+            "lease_generation": lease_generation,
+            "editor_generation": 7,
+            "operation_id": "rename-baseline-op",
+            "revision": 3,
+        }))
+        .expect("legacy rename should succeed");
+        assert_eq!(
+            ack["commit_state"],
+            json!("committed"),
+            "previous response lacks exact bound commit ack: {ack}"
+        );
+    }
+
