{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Course Workbench",
  "version": "0.1.1",
  "identifier": "io.github.wyzh0117.ai-course-workbench",
  "build": {
    "frontendDist": "../app",
    "devUrl": "http://localhost:4173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "AI Course Workbench", "width": 1440, "height": 900, "minWidth": 980, "minHeight": 640 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Education",
    "copyright": "AI Course Workbench",
    "shortDescription": "Local-first course authoring workbench with an auditable AI assistant.",
    "longDescription": "AI Course Workbench is a local-first desktop workbench for building course projects: course map, lesson editor, requirements, assets, six-dimension status, an AI assistant that only proposes reviewable changes, and an output/publish center. Project data lives in an open project.json on your own disk.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  }
}