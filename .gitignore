# ---- Build output ----------------------------------------------------------
# Rust build tree produced by `cargo` / `tauri build` (~4 GB). Never commit it.
src-tauri/target/
target/

# Stray compiler output at the repo root (`rustc file.rs` writes ./rust_out).
rust_out

# ---- Release staging -------------------------------------------------------
# Scratch space for a local release build: the renamed DMG, its .sha256, the
# checksum comparison and the mount point used by the install smoke. All of it
# is either reproducible or uploaded as a GitHub Release asset, never committed.
.release/
.release-tmp/
dist/
*.dmg
*.dmg.sha256

# ---- Local workbench data --------------------------------------------------
# The app's own working project: Canonical project.json, imported assets, and
# the rebuildable .workspace caches (index.json, snapshots, diagnostics) plus
# the runtime project.lock and project.json.bak auto-backup.
#
# This is local user data, not product source. Delete this rule if you *want*
# your working course project versioned alongside the code.
.workbench-project/

# ---- OS / editor noise -----------------------------------------------------
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
*~
.Rhistory

# Per-editor agent state (statusline/hook wiring, editor-local rules). The
# shared, portable agent guidance lives in the committed AGENTS.md instead.
.claude/
.cursor/

# ---- Local overrides -------------------------------------------------------
.env
.env.*
*.local

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/
